# Copy this file to budget-it.env (same folder as server.js), fill in what you use,
# then restart:  systemctl --user restart budget-it
# Leave a line empty to keep that feature off. Never commit budget-it.env or paste its keys anywhere.

# ---- Banks, through Plaid (dashboard.plaid.com > Developers > Keys) ----
# Optional: CSV import and accounts you keep by hand work without it. Try sandbox for a week before a real bank.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox = Plaid's made-up test bank (sign in with user_good / pass_good). production = real banks.
# The secret is different for each: use the Sandbox secret with sandbox and the Production secret with production.
PLAID_ENV=sandbox
PLAID_COUNTRIES=CA,US
# How often to ask the banks for new transactions, in hours (the app also updates when you tap the button)
SYNC_HOURS=6
# Plaid's free plan allows 10 bank connections for the whole laptop, for good, and a disconnected bank still counts.
# The app shows how many are used and asks before each new one. On pay as you go, write 0 to stop counting.
PLAID_ITEM_LIMIT=10
# Some banks approve the connection in their own app or site and need an address to send you back to:
# your PUBLIC_URL followed by /plaid/return. It must be https, and listed in the Plaid dashboard under
# Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=

# Optional: the key that encrypts bank connections. If empty, Budget it makes data/secret.key on first run.
# If you set it, keep a copy somewhere safe: without it the bank connections can't be read and need connecting again.
BUDGET_IT_KEY=

# ---- Backups ----
# A second place for backups that isn't this laptop's disk: a USB drive, or a folder that
# Dropbox, Syncthing or Nextcloud sends somewhere else. A full backup goes there once a day, 14 are kept.
# The owner's page warns when this is empty or the copy is getting old.
BACKUP_COPY_DIR=
# Locks those copies (and backups made from the terminal) so nobody who finds the drive can read them.
# At least 8 characters. Write it down somewhere that isn't the laptop: a locked backup can't be opened without it.
# Until it's set, those copies leave out secret.key (the bank key) while a bank is connected; they restore on this laptop only.
BACKUP_PASSPHRASE=

# ---- Sign-in extras, the same as Split it ----
# The address people open, used in email links, Google and the AI assistant. No slash at the end.
PUBLIC_URL=https://your-laptop.your-tailnet.ts.net
# Emails (check your email, forgot password), from resend.com
RESEND_API_KEY=
MAIL_FROM=Budget it <hello@yourdomain.com>
# "Continue with Google", from console.cloud.google.com (OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The owner's page asks GitHub whether a newer Budget it is out (nothing about you is sent).
# Write off to stop that.
UPDATE_CHECK=

# ---- Running it on a server or behind a proxy (Coolify, Traefik, a Cloudflare tunnel) ----
# Your time zone. Bill reminders, the Sunday check-in and what counts as "today" use it.
# Containers run on UTC unless you set it. Names come from en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Toronto
# Budget it believes the visitor's address that a proxy passes on (CF-Connecting-IP, X-Forwarded-For) when the
# request comes from a private, loopback or Docker address, which is where a proxy lives. That keeps the
# wrong-password limit per visitor instead of one limit shared by everyone. Add your proxy's address here if it
# isn't on a private network (addresses or ranges, comma separated, like 203.0.113.5,198.51.100.0/24),
# or write none when nothing sits in front of Budget it.
TRUSTED_PROXY=
# Split it on this laptop or your home network (for example http://localhost:8080, or http://split-it:8080
# in Docker). Budget it then only connects to that Split it. Left empty, only a public https address works,
# so nobody can use the Split it setting to reach other things on your network.
SPLIT_IT_URL=
# When a tunnel or proxy is the only way in, keep the port on this computer only, so nobody on the same
# Wi-Fi can go around it: the plain install already listens on 127.0.0.1 (HOST), and in compose.yaml write
# "127.0.0.1:8090:8090" under ports. Coolify's Traefik reaches the container over Docker's own network, so it still works.
